FROM recursus-rc3-v12:final@sha256:4bfd405ff14b51b2b895aace2844f65d84a159d925e3a58e47bc9343b1745d8c

USER root
RUN rm /opt/rc3/recursus-route-credential-permission-v12.mjs \
    /opt/rc3/recursus-route-denial-probe-v12.mjs \
    /opt/rc3/recursus-route-proxy-v12.mjs \
    /opt/rc3/recursus-route-relay-v12.mjs \
    /opt/rc3/recursus-route-socket-init-v12.mjs \
    /opt/rc3/recursus-route-worker-v12.mjs
COPY runner/ /opt/rc3/
RUN chown -R 65532:65532 /opt/rc3 \
    && chmod -R go-w /opt/rc3
USER 65532:65532
WORKDIR /opt/rc3
ENTRYPOINT ["/usr/local/bin/node"]
