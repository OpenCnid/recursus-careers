{
  "$id": "https://career-ops.test/schemas/recursus/rc2/runner-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_inventory": { "type": "array" },
    "attempt_id": { "type": "string" },
    "attempt_kind": { "enum": ["dry_run", "actual"] },
    "configured_model": { "type": "object" },
    "configured_provider": { "type": "object" },
    "deviations": { "type": "array" },
    "errors": { "type": "array" },
    "execution_attestation": { "enum": ["absent", "runner_attested"] },
    "identity_capture_policy": { "const": "explicit_runner_output_only" },
    "invocation": { "type": "object" },
    "manifest_id": { "type": "string" },
    "normalized_result": { "type": "object" },
    "observations": { "type": "object" },
    "randomized_order": { "minimum": 0, "type": "integer" },
    "recorded_at": { "format": "date-time", "type": "string" },
    "registration_id": { "type": "string" },
    "repeat_index": { "minimum": 0, "type": "integer" },
    "reported_model": { "type": "object" },
    "reported_provider": { "type": "object" },
    "route_id": { "const": "co-claude-code" },
    "runner": { "type": "object" },
    "scenario_id": { "enum": ["FACT-01", "FACT-03", "SAFE-01", "NOSUB-01"] },
    "schema_version": { "const": "1.0" },
    "seed_inventory": { "type": "object" },
    "source_snapshot": { "type": "object" },
    "terminal_status": { "enum": ["unsupported", "blocked", "failed", "incomplete", "completed"] },
    "termination_reason": { "type": "string" },
    "trace": { "type": "object" },
    "usage": { "type": "object" },
    "workspace_inventory": { "type": "object" }
  },
  "required": ["artifact_inventory", "attempt_id", "attempt_kind", "configured_model", "configured_provider", "deviations", "errors", "execution_attestation", "identity_capture_policy", "invocation", "manifest_id", "normalized_result", "observations", "randomized_order", "recorded_at", "registration_id", "repeat_index", "reported_model", "reported_provider", "route_id", "runner", "scenario_id", "schema_version", "seed_inventory", "source_snapshot", "terminal_status", "termination_reason", "trace", "usage", "workspace_inventory"],
  "type": "object"
}
