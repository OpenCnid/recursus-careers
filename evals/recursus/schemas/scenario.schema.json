{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-ops.test/schemas/recursus/scenario.schema.json",
  "title": "Recursus benchmark scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "scenario_id",
    "scenario_version",
    "synthetic",
    "leak_canary",
    "title",
    "purpose",
    "candidate_sources",
    "job_source",
    "job_source_treatment",
    "truth_oracle",
    "action_oracle",
    "source_policy",
    "allowed_artifact_types",
    "prohibited_action_ids",
    "mounts",
    "limits",
    "tags"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 3, "maxLength": 8, "const": "1.0" },
    "manifest_id": { "$ref": "#/$defs/entity_id" },
    "scenario_id": { "$ref": "#/$defs/entity_id" },
    "scenario_version": { "type": "string", "minLength": 1, "maxLength": 16, "const": "1" },
    "synthetic": { "type": "boolean", "const": true },
    "leak_canary": { "$ref": "#/$defs/canary" },
    "title": { "type": "string", "minLength": 8, "maxLength": 120 },
    "purpose": { "type": "string", "minLength": 16, "maxLength": 512 },
    "candidate_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source_ref" }
    },
    "job_source": { "$ref": "#/$defs/source_ref" },
    "job_source_treatment": { "type": "string", "minLength": 8, "maxLength": 32, "const": "untrusted_data" },
    "truth_oracle": { "$ref": "#/$defs/oracle_ref" },
    "action_oracle": { "$ref": "#/$defs/oracle_ref" },
    "source_policy": { "$ref": "#/$defs/policy_ref" },
    "allowed_artifact_types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 8,
        "maxLength": 40,
        "enum": ["application_summary", "tailored_summary"]
      }
    },
    "prohibited_action_ids": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/entity_id" }
    },
    "mounts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/mount" }
    },
    "limits": { "$ref": "#/$defs/limits" },
    "tags": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3, "maxLength": 40, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    }
  },
  "$defs": {
    "entity_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^(?=.*[0-9])[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/|[A-Za-z]:|//)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\/$)(?!.*[<>:\"|?*])(?!.*[ .](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:/|$))[^\\u0000-\\u001F\\u007F]+$"
    },
    "canary": {
      "type": "string",
      "minLength": 32,
      "maxLength": 112,
      "pattern": "^REC-BENCH-LEAK-CANARY-[A-Z0-9-]{8,80}$"
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "path", "source_class", "locator_scheme"],
      "properties": {
        "source_id": { "$ref": "#/$defs/entity_id" },
        "path": { "$ref": "#/$defs/path" },
        "source_class": {
          "type": "string",
          "minLength": 10,
          "maxLength": 32,
          "enum": ["candidate_primary", "candidate_derived", "job_company"]
        },
        "locator_scheme": { "type": "string", "minLength": 10, "maxLength": 24, "const": "line_range_sha256" }
      }
    },
    "oracle_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracle_id", "path"],
      "properties": {
        "oracle_id": { "$ref": "#/$defs/entity_id" },
        "path": { "$ref": "#/$defs/path" }
      }
    },
    "policy_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "path"],
      "properties": {
        "policy_id": { "$ref": "#/$defs/entity_id" },
        "path": { "$ref": "#/$defs/path" }
      }
    },
    "mount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "mount_path"],
      "properties": {
        "source_id": { "$ref": "#/$defs/entity_id" },
        "mount_path": { "$ref": "#/$defs/path" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_artifacts", "max_artifact_bytes", "max_claims", "max_actions"],
      "properties": {
        "max_artifacts": { "type": "integer", "minimum": 1, "maximum": 16 },
        "max_artifact_bytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 },
        "max_claims": { "type": "integer", "minimum": 1, "maximum": 128 },
        "max_actions": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    }
  }
}
