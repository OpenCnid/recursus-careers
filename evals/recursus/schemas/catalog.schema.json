{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-ops.test/schemas/recursus/catalog.schema.json",
  "title": "Recursus benchmark catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "corpus_version",
    "synthetic",
    "canonical_serialization",
    "line_endings",
    "scenarios",
    "files"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 3, "maxLength": 8, "const": "1.0" },
    "corpus_id": { "$ref": "#/$defs/entity_id" },
    "corpus_version": { "type": "string", "minLength": 8, "maxLength": 64, "const": "career-bench-v1" },
    "synthetic": { "type": "boolean", "const": true },
    "canonical_serialization": { "type": "string", "minLength": 8, "maxLength": 64, "const": "recursus-canonical-json-v1" },
    "line_endings": { "type": "string", "minLength": 2, "maxLength": 8, "const": "LF" },
    "scenarios": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/scenario_entry" }
    },
    "files": {
      "type": "array",
      "minItems": 16,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/file_entry" }
    }
  },
  "$defs": {
    "entity_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^(?=.*[0-9])[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/|[A-Za-z]:|//)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\/$)(?!.*[<>:\"|?*])(?!.*[ .](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:/|$))[^\\u0000-\\u001F\\u007F]+$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "scenario_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "manifest_path"],
      "properties": {
        "scenario_id": { "$ref": "#/$defs/entity_id" },
        "manifest_path": { "$ref": "#/$defs/path" }
      }
    },
    "file_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_id",
        "path",
        "sha256",
        "byte_count",
        "visibility",
        "kind",
        "media_type",
        "synthetic"
      ],
      "properties": {
        "file_id": { "$ref": "#/$defs/entity_id" },
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "visibility": {
          "type": "string",
          "minLength": 12,
          "maxLength": 14,
          "enum": ["agent_visible", "evaluator_only"]
        },
        "kind": {
          "type": "string",
          "minLength": 6,
          "maxLength": 32,
          "enum": ["source", "scenario", "source_policy", "truth_oracle", "action_oracle", "evaluator_fixture"]
        },
        "media_type": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "enum": ["application/json", "text/markdown", "text/plain"]
        },
        "synthetic": { "type": "boolean", "const": true },
        "source_id": { "$ref": "#/$defs/entity_id" },
        "source_class": {
          "type": "string",
          "minLength": 10,
          "maxLength": 32,
          "enum": ["candidate_primary", "candidate_derived", "job_company"]
        },
        "capture_date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "locator_scheme": {
          "type": "string",
          "minLength": 10,
          "maxLength": 24,
          "const": "line_range_sha256"
        }
      }
    }
  }
}
