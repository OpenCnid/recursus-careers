{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-ops.test/schemas/recursus/run-manifest.schema.json",
  "title": "Recursus benchmark run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "scenario_id",
    "synthetic",
    "example",
    "product",
    "workflow",
    "runner",
    "harness",
    "provider",
    "model",
    "permission_profile",
    "corpus",
    "tool_versions",
    "repository_commit",
    "route_id",
    "budgets",
    "protocol_deviations",
    "timing",
    "usage",
    "artifact_hashes",
    "terminal_status",
    "execution_attestation"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 3, "maxLength": 8, "const": "1.0" },
    "run_id": { "$ref": "#/$defs/entity_id" },
    "scenario_id": { "$ref": "#/$defs/entity_id" },
    "synthetic": { "type": "boolean", "const": true },
    "example": { "type": "boolean", "const": true },
    "product": { "$ref": "#/$defs/identity" },
    "workflow": { "$ref": "#/$defs/identity" },
    "runner": { "$ref": "#/$defs/identity" },
    "harness": { "$ref": "#/$defs/identity" },
    "provider": { "$ref": "#/$defs/reportable_identity" },
    "model": { "$ref": "#/$defs/model_identity" },
    "permission_profile": { "$ref": "#/$defs/identity" },
    "corpus": { "$ref": "#/$defs/corpus_identity" },
    "tool_versions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identity" }
    },
    "repository_commit": {
      "type": "string",
      "minLength": 12,
      "maxLength": 64,
      "pattern": "^(?:not_reported|[a-f0-9]{40,64})$"
    },
    "route_id": { "type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "budgets": { "$ref": "#/$defs/budgets" },
    "protocol_deviations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/deviation" }
    },
    "timing": { "$ref": "#/$defs/timing" },
    "usage": { "$ref": "#/$defs/usage" },
    "artifact_hashes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact_hash" }
    },
    "terminal_status": {
      "type": "string",
      "minLength": 6,
      "maxLength": 16,
      "enum": ["unsupported", "blocked", "failed", "incomplete", "completed"]
    },
    "execution_attestation": {
      "type": "string",
      "minLength": 6,
      "maxLength": 20,
      "enum": ["absent", "self_reported", "runner_attested"]
    }
  },
  "$defs": {
    "entity_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^(?=.*[0-9])[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 96 },
        "version": { "type": "string", "minLength": 1, "maxLength": 96 }
      }
    },
    "reportable_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 96 },
        "version": { "type": "string", "minLength": 1, "maxLength": 96 }
      }
    },
    "model_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128 },
        "revision": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "corpus_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "schema_version"],
      "properties": {
        "id": { "$ref": "#/$defs/entity_id" },
        "version": { "type": "string", "minLength": 8, "maxLength": 64, "const": "career-bench-v1" },
        "schema_version": { "type": "string", "minLength": 3, "maxLength": 8, "const": "1.0" }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_artifacts", "max_artifact_bytes", "max_claims", "max_actions"],
      "properties": {
        "max_artifacts": { "type": "integer", "minimum": 1, "maximum": 16 },
        "max_artifact_bytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 },
        "max_claims": { "type": "integer", "minimum": 1, "maximum": 128 },
        "max_actions": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "deviation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviation_id", "kind", "description"],
      "properties": {
        "deviation_id": { "$ref": "#/$defs/entity_id" },
        "kind": { "type": "string", "minLength": 5, "maxLength": 40 },
        "description": { "type": "string", "minLength": 12, "maxLength": 512 }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_ms"],
      "properties": {
        "wall_ms": { "type": ["integer", "null"], "minimum": 0, "maximum": 31536000000 }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "cached_input_tokens", "output_tokens", "reasoning_tokens", "cost_usd"],
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000000 },
        "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000000 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000000 },
        "reasoning_tokens": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000000 },
        "cost_usd": { "type": ["number", "null"], "minimum": 0, "maximum": 1000000000 }
      }
    },
    "artifact_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256", "byte_count"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/entity_id" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 0, "maximum": 1048576 }
      }
    }
  }
}
