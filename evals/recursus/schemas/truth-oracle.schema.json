{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-ops.test/schemas/recursus/truth-oracle.schema.json",
  "title": "Recursus benchmark truth oracle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "oracle_id", "synthetic", "visibility", "leak_canary", "claims"],
  "properties": {
    "schema_version": { "type": "string", "minLength": 3, "maxLength": 8, "const": "1.0" },
    "oracle_id": { "$ref": "#/$defs/entity_id" },
    "synthetic": { "type": "boolean", "const": true },
    "visibility": { "type": "string", "minLength": 14, "maxLength": 14, "const": "evaluator_only" },
    "leak_canary": { "$ref": "#/$defs/canary" },
    "claims": {
      "type": "array",
      "minItems": 6,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/claim" }
    }
  },
  "$defs": {
    "entity_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^(?=.*[0-9])[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/|[A-Za-z]:|//)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\/$)(?!.*[<>:\"|?*])(?!.*[ .](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:/|$))[^\\u0000-\\u001F\\u007F]+$"
    },
    "sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
    "canary": {
      "type": "string",
      "minLength": 32,
      "maxLength": 112,
      "pattern": "^REC-BENCH-LEAK-CANARY-[A-Z0-9-]{8,80}$"
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "start_line", "end_line", "excerpt_sha256"],
      "properties": {
        "kind": { "type": "string", "minLength": 10, "maxLength": 16, "const": "line_range" },
        "start_line": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "end_line": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "excerpt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "relationship", "selector"],
      "properties": {
        "source_path": { "$ref": "#/$defs/path" },
        "relationship": {
          "type": "string",
          "minLength": 7,
          "maxLength": 16,
          "enum": ["supports", "contradicts", "mentions"]
        },
        "selector": { "$ref": "#/$defs/selector" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "scenario_ids", "normalized_proposition", "disposition", "source_locators", "conflict_note", "acceptable_renderings"],
      "properties": {
        "claim_id": { "$ref": "#/$defs/entity_id" },
        "scenario_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/entity_id" }
        },
        "normalized_proposition": { "type": "string", "minLength": 12, "maxLength": 1024 },
        "disposition": {
          "type": "string",
          "minLength": 7,
          "maxLength": 16,
          "enum": ["supported", "contradicted", "unknown", "ambiguous"]
        },
        "source_locators": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/locator" }
        },
        "conflict_note": { "type": ["string", "null"], "minLength": 12, "maxLength": 1024 },
        "acceptable_renderings": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 160 }
        }
      }
    }
  }
}
